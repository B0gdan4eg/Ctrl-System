# Python bytecode (регенерируется)
__pycache__/
*.py[cod]
*$py.class

# Сборки
build/
dist/
dist win/
*.spec
*.egg-info/
*.egg

# Виртуальные окружения (ставятся из requirements.txt)
venv/
venv38/
venv311/
ENV/
env/
.venv

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Логи (регенерируются при запуске)
logs/*.log
*.log

# Рантайм-снапшоты камеры (регенерируются)
camera_*.png
camera_*.jpg
snapshot_*.png
snapshot_*.jpg

# Секреты
.env
.env.local
.claude/.credentials.json

# Кэши тестов
.pytest_cache/
.coverage
htmlcov/

# Временные файлы и БД
*.tmp
*.temp
*.cache
*.db
*.sqlite
*.sqlite3
